@API_BASE_PATH = http://localhost:5002

@TestUser = user16
@TestPassword = P@ssw0rd_123

# register
POST {{API_BASE_PATH}}/auth/register
Content-Type: application/json

{
    "username": "{{TestUser}}",
    "password": "{{TestPassword}}"
}

# login
POST {{API_BASE_PATH}}/auth/login
Content-Type: application/json

{
    "username": "{{TestUser}}",
    "password": "{{TestPassword}}"
}

@AccessToken = XXXXX
@RefreshTokenCookie = refreshToken=XXXXX

# refresh
POST {{API_BASE_PATH}}/auth/refresh
Content-Type: application/json
Cookie: {{RefreshTokenCookie}}

# logout
POST {{API_BASE_PATH}}/auth/logout
Content-Type: application/json
Cookie: {{RefreshTokenCookie}}

# change password
POST {{API_BASE_PATH}}/auth/change-password
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
    "oldPassword": "{{TestPassword}}",
    "newPassword": "{{TestPassword}}_NEW"
}


# create a short url as test user
POST {{API_BASE_PATH}}/short-urls/
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
    "originalUrl": "https://www.google.com",
    "expiresAt": null
}

@ShortUrlCode = XXXXX
@ShortUrlId = 12345

# click a url
GET {{API_BASE_PATH}}/redirection/{{ShortUrlCode}}
Content-Type: application/json

# query users created by the user
GET {{API_BASE_PATH}}/short-urls?orderBy=ClickCount&age=2&pagesize=1
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

# query certain short url by its id
GET {{API_BASE_PATH}}/short-urls/{{ShortUrlId}}
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

