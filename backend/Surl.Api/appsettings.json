{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=db;Database=surl;Username=surl_rw;Password=xxx"
  },
  "Secrets": {
    "DB_Default_Password_File": "/run/secrets/surl_rw_password",
    "JWT_SECRET_FILE": "/run/secrets/jwt_secret"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "IdOptions": {
    "Epoch": "2026-01-01T00:00:00Z",
    "TimestampBits": 41,
    "WorkerIdBits": 4,
    "SequenceBits": 18,
    "WorkerId": 0
  },
  "ApiSettings": {
    "DisallowedHosts": []
  },
  "Jwt": {
    "SecretKey": "PLACEHOLDER",
    "Issuer": "http://localhost:5000",
    "Audience": "aago.api",
    "AccessTokenExpireInMinutes": 15,
    "RefreshTokenExpireInDays": 7
  },
  "DefaultAdmin": {
    "Username": "PLACEHOLDER",
    "Password": "PLACEHOLDER"
  }
}