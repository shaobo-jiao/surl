{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=db;Database=surl;Username=surl_rw;Password=xxx"
  },
  "Secrets": {
    "DbDefaultPasswordFile": "/run/secrets/surl-rw-password",
    "JwtSecretKeyFile": "/run/secrets/jwt-secret-key"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "IdOptions": {
    "Epoch": "2026-01-01T00:00:00Z",
    "TimestampBits": 41,
    "WorkerIdBits": 4,
    "SequenceBits": 18,
    "WorkerId": 0
  },
  "ApiSettings": {
    "DisallowedHosts": []
  },
  "JwtOptions": {
    "SecretKey": "PLACEHOLDER",
    "Issuer": "http://localhost:5002",
    "Audience": "surl-api",
    "AccessTokenExpireInMinutes": 15,
    "RefreshTokenExpireInDays": 7
  },
  "DefaultAdmin": {
    "Enabled": false,
    "Username": "PLACEHOLDER",
    "Password": "PLACEHOLDER"
  }
}